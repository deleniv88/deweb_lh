RewriteEngine On

# www → адреса без www (одразу на https, одним редиректом)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# http → https
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# /index.html → / (щоб одна сторінка не відкривалась за двома адресами)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]

# Мова браузера: лише для головної /, лише для людей (боти й прев'ю месенджерів завжди бачать польську).
# 1) Якщо людина вже обрала мову в перемикачі (cookie dw_lang) — відкриваємо її.
# 2) Інакше за мовою браузера: українська або російська → /ua/; якщо серед мов браузера є польська — лишається польська /;
#    будь-яка інша (англійська, німецька…) → /en/. Без мови в запиті — польська.
# 302 — тимчасовий редирект, тож Google і далі індексує / як польську сторінку.
RewriteCond %{REQUEST_URI} ^/$
RewriteCond %{HTTP_USER_AGENT} !(bot|crawl|spider|slurp|facebookexternalhit|whatsapp|telegram|preview|lighthouse|headless) [NC]
RewriteCond %{HTTP_COOKIE} (^|;\s*)dw_lang=ua(;|$)
RewriteRule ^ /ua/ [L,R=302]

RewriteCond %{REQUEST_URI} ^/$
RewriteCond %{HTTP_USER_AGENT} !(bot|crawl|spider|slurp|facebookexternalhit|whatsapp|telegram|preview|lighthouse|headless) [NC]
RewriteCond %{HTTP_COOKIE} (^|;\s*)dw_lang=en(;|$)
RewriteRule ^ /en/ [L,R=302]

RewriteCond %{REQUEST_URI} ^/$
RewriteCond %{HTTP_USER_AGENT} !(bot|crawl|spider|slurp|facebookexternalhit|whatsapp|telegram|preview|lighthouse|headless) [NC]
RewriteCond %{HTTP_COOKIE} !(^|;\s*)dw_lang=
RewriteCond %{HTTP:Accept-Language} ^\s*(uk|ru)\b [NC]
RewriteRule ^ /ua/ [L,R=302]

RewriteCond %{REQUEST_URI} ^/$
RewriteCond %{HTTP_USER_AGENT} !(bot|crawl|spider|slurp|facebookexternalhit|whatsapp|telegram|preview|lighthouse|headless) [NC]
RewriteCond %{HTTP_COOKIE} !(^|;\s*)dw_lang=
RewriteCond %{HTTP:Accept-Language} .
RewriteCond %{HTTP:Accept-Language} !\bpl\b [NC]
RewriteRule ^ /en/ [L,R=302]

# Польська тепер основна (/), тому старі адреси /pl/... → ті самі сторінки без /pl (назавжди, 301).
# Польські роботи — на /realizacje/ (старі /pl/works/ теж туди). Старі /works/ були англійськими → /en/works/.
RewriteRule ^pl/works/?$ /realizacje/ [L,R=301]
RewriteRule ^works/?$ /en/works/ [L,R=301]
RewriteRule ^pl/?$ / [L,R=301]
RewriteRule ^pl/(.*)$ /$1 [L,R=301]

# Прихована сторінка перевірки сайту (/audyt/, /en/audit/, /ua/audyt/) — лише за посиланням.
# Пошуковим і SEO-ботам — 403, щоб вони її не бачили навіть за випадковим посиланням. Прев'ю месенджерів (Telegram, WhatsApp, Facebook) пропускаємо.
RewriteCond %{HTTP_USER_AGENT} (googlebot|google-inspectiontool|bingbot|bingpreview|yandex|baiduspider|duckduckbot|applebot|petalbot|seznambot|sogou|exabot|ahrefs|semrush|mj12bot|dotbot|blexbot|serpstat|dataforseo|megaindex|bytespider|gptbot|oai-searchbot|claudebot|ccbot|perplexitybot|amazonbot|meta-externalagent) [NC]
RewriteRule ^(audyt|en/audit|ua/audyt)(/|$) - [F,L]

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2|webp|avif|png|jpg|jpeg|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # браузер завжди відкриває сайт лише по https (без субдоменів: dentistica.deweb.studio живе окремо)
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # прихована сторінка перевірки сайту: не індексувати, навіть якщо бот її знайде
  <If "%{REQUEST_URI} =~ m#^/(audyt|en/audit|ua/audyt)(/|$)#">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </If>
  # головна залежить від мови браузера й cookie — кеші не мають віддавати одну версію всім
  <If "%{REQUEST_URI} == '/' || %{REQUEST_URI} == '/index.html'">
    Header append Vary "Accept-Language, Cookie"
  </If>
</IfModule>

Options -Indexes
